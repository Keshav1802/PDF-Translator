{
  "manifest_version": 3,
  "name": "PDF Translator",
  "version": "1.0.0",
  "description": "Translates PDFs in real-time preserving original layout, fonts, and graphics with zero downloads required.",
  "author": "Keshav",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Translate PDF"
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": [
      "background/background.js"
    ]
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pdf-translator-extension@keshav.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/*",
        "lib/*",
        "services/*",
        "icons/*",
        "sample_french_article.pdf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}